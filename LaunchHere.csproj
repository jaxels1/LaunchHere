<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LaunchHere</RootNamespace>
    <AssemblyName>LaunchHere</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>LaunchHere.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Runtime.Serialization" /><Reference Include="System.Xml" />
    <Compile Include="LaunchHere.cs" /><Compile Include="Settings.cs" /><Compile Include="SettingsWindow.cs" /><Compile Include="AssemblyInfo.cs" />
    <Content Include="LaunchHere.exe.config"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <None Include="app.manifest" /><None Include="LaunchHere.ico" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
